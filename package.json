{
  "name": "@juspay/cards-validator",
  "version": "0.1.0",
  "description": "A JS/TS lib for validating credit and debit card numbers, determining card types, and providing card-specific information like CVV length",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "rollup --config rollup.config.js",
    "dev": "rollup --config rollup.config.js --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juspay/cards-validator.git"
  },
  "homepage": "https://github.com/juspay/cards-validator#readme",
  "keywords": [
    "credit-card",
    "card-validation",
    "payment",
    "typescript",
    "validator",
    "cvv",
    "luhn"
  ],
  "author": "Juspay Technologies Pvt Ltd",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "rollup": "^4.55.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
